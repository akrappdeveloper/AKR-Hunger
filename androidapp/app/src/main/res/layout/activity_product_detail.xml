<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Product Image Carousel Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="330dp">

                <!-- ViewPager2 Image Carousel -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vp_product_images"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Fallback single image (shown when only 1 image) -->
                <ImageView
                    android:id="@+id/iv_product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Top Shadow Scrim for Floating Bar -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_gravity="top"
                    android:background="@drawable/gradient_bottom_overlay"
                    android:rotation="180" />

                <!-- Bottom Shadow Scrim for Guarantee Pill & Dots -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_bottom_overlay" />

                <!-- Top Floating Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Back Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_back"
                            app:tint="@color/text_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Share Button (Web App Mirror) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_share"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Share"
                            android:src="@drawable/ic_share_2"
                            app:tint="@color/text_primary" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Favorite Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_favorite"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="4dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/iv_favorite"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/nav_favorites"
                            android:src="@drawable/ic_nav_favorites_outline"
                            app:tint="@color/text_hint" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Veg / Non-Veg Indicator Floating Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="72dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="4dp"
                    app:contentPaddingBottom="5dp"
                    app:contentPaddingLeft="8dp"
                    app:contentPaddingRight="10dp"
                    app:contentPaddingTop="5dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Veg/Non-Veg Outer Square Frame with Inner Dot -->
                        <FrameLayout
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_badge"
                            android:padding="3dp">

                            <View
                                android:id="@+id/veg_dot"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle_primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.02"
                            android:text="FRESH FOOD"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Image Counter Badge (top-right or dynamic) -->
                <TextView
                    android:id="@+id/tv_image_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="72dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_pill_white"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Bottom Guarantee Floating Pill inside Image -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="5dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_shield_check"
                            app:tint="@color/success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Tamper-Proof Pack"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="30-min Delivery"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Image Dots Indicator -->
                <LinearLayout
                    android:id="@+id/ll_image_dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="54dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="6dp" />
            </FrameLayout>

            <!-- Product Details Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="25sp" />

                <!-- Clickable Restaurant Origin Subtitle -->
                <LinearLayout
                    android:id="@+id/row_restaurant_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pill_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tv_product_restaurant"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="4dp"
                        android:rotation="180"
                        android:src="@drawable/ic_back"
                        app:tint="@color/primary" />
                </LinearLayout>

                <!-- Base Price & Pill Badges Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/primary"
                        android:textSize="28sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Prep Time Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_soft"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tv_prep_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="25 min"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Rating Pill -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/card_border"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/rating_star" />

                            <TextView
                                android:id="@+id/tv_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="sans-serif-black"
                                android:text="4.8"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <!-- Description Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="ABOUT THIS DISH"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_product_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3.5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <!-- Portion Size Selection Card Container (Optional) -->
                <TextView
                    android:id="@+id/tv_portion_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="CHOOSE SIZE (OPTIONAL)"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <RadioGroup
                    android:id="@+id/rg_portion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_portion_regular"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Regular"
                        android:textColor="@color/sel_option_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_portion_medium"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Medium (+₹40)"
                        android:textColor="@color/sel_option_text"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rb_portion_large"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Large (+₹80)"
                        android:textColor="@color/sel_option_text"
                        android:textSize="12sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <!-- Spice Level Preference Card Container (Optional) -->
                <TextView
                    android:id="@+id/tv_spice_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="SPICE LEVEL (OPTIONAL)"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <RadioGroup
                    android:id="@+id/rg_spice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_spice_mild"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Mild 🌿"
                        android:textColor="@color/sel_option_text"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spice_medium"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Medium 🔥"
                        android:textColor="@color/sel_option_text"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spice_hot"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Hot 🌶️"
                        android:textColor="@color/sel_option_text"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spice_extra"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_option_card"
                        android:button="@null"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="Extra 💥"
                        android:textColor="@color/sel_option_text"
                        android:textSize="11sp" />
                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <!-- Add-ons & Extras (Optional) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="ADD-ONS &amp; EXTRAS (OPTIONAL)"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/ll_addons_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <!-- Special Cooking Request (Web App Mirror) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:text="SPECIAL COOKING REQUEST"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.AKR.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Kitchen instructions (e.g. less oil, extra chutney)"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:startIconDrawable="@drawable/ic_chef"
                    app:startIconMinSize="48dp"
                    app:startIconScaleType="centerInside"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_cooking_instructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:inputType="textCapSentences"
                        android:maxLines="2"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quantity Stepper Row -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="Quantity"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Select number of servings"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Modern Pill Stepper with Rounded Buttons -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_pill_soft"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="4dp">

                            <TextView
                                android:id="@+id/btn_minus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_quantity"
                                android:layout_width="36dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/btn_plus"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Store Guarantee & Authentic Quality Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_circle_soft">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="100% Quality &amp; Hygiene Assured"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif"
                                android:text="Prepared fresh on order with strict sanitization standards"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Bar with Total Price, Add To Cart & Buy Now Buttons (Mirroring Web App) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="TOTAL"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_bottom_total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tv_bottom_spice_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Medium Spice"
                    android:textColor="@color/primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Add to Cart Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_to_cart"
                style="@style/Widget.AKR.Button.PillSoft"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="14dp"
                android:text="Add to Cart"
                android:textSize="12sp"
                app:icon="@drawable/ic_cart"
                app:iconSize="16dp"
                app:iconTint="@color/primary" />

            <!-- Buy Now Pill Button (Direct Checkout like Web App) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_buy_now"
                style="@style/Widget.AKR.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:text="Buy Now"
                android:textSize="13sp"
                app:backgroundTint="@color/primary"
                app:icon="@drawable/ic_zap"
                app:iconSize="16dp"
                app:iconTint="@color/on_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>