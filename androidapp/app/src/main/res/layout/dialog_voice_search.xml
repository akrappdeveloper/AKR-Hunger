<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_ios"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- iOS Bottom Sheet Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dot_white"
        android:backgroundTint="@color/divider_hairline" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Voice Search"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="Search dishes, restaurants &amp; cuisines"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_close_voice"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle_gray"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Animated Sound Wave & Microphone Stage -->
    <FrameLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp">

        <!-- Outer Ripple Ring 3 -->
        <View
            android:id="@+id/wave_ring_3"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:alpha="0.2"
            android:background="@drawable/bg_voice_pulse_ring" />

        <!-- Middle Ripple Ring 2 -->
        <View
            android:id="@+id/wave_ring_2"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_gravity="center"
            android:alpha="0.35"
            android:background="@drawable/bg_voice_pulse_ring" />

        <!-- Inner Ripple Ring 1 -->
        <View
            android:id="@+id/wave_ring_1"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center"
            android:alpha="0.55"
            android:background="@drawable/bg_voice_pulse_ring" />

        <!-- Center Glowing Mic Button -->
        <FrameLayout
            android:id="@+id/btn_voice_mic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_voice_mic_button"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_mic_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:tint="@color/on_primary" />
        </FrameLayout>
    </FrameLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tv_voice_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_voice_status"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:text="● Listening... Speak now"
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <!-- Live Transcribed Speech Output -->
    <TextView
        android:id="@+id/tv_speech_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lines="2"
        android:maxLines="2"
        android:text="Say something like 'Chicken Biryani'…"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <!-- Sound Wave Bars (Visualizer Effect) -->
    <LinearLayout
        android:id="@+id/layout_wave_bars"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/bar_1"
            android:layout_width="3.5dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/bg_pill_primary" />

        <View
            android:id="@+id/bar_2"
            android:layout_width="3.5dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/bg_pill_primary" />

        <View
            android:id="@+id/bar_3"
            android:layout_width="3.5dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/bg_pill_primary" />

        <View
            android:id="@+id/bar_4"
            android:layout_width="3.5dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/bg_pill_primary" />

        <View
            android:id="@+id/bar_5"
            android:layout_width="3.5dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/bg_pill_primary" />
    </LinearLayout>

    <!-- Suggestions Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:text="Try saying"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Suggestion Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_suggestion_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_voice_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🍗 Chicken Biryani"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_suggestion_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_voice_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🍕 Cheese Pizza"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_suggestion_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_voice_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🍔 Truffle Burger"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chip_suggestion_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_voice_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🍨 Cold Dessert"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
