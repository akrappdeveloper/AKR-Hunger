<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_map_card_top"
    android:orientation="vertical">

    <!-- Top Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <FrameLayout
            android:id="@+id/btn_close_map"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_circle_gray"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Location on Map"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Drag the map to pinpoint delivery spot"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Header Quick GPS Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_header_gps"
            style="@style/Widget.AKR.Button.PillSoft"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:text="GPS"
            android:textSize="12sp"
            app:icon="@drawable/ic_location"
            app:iconSize="14dp"
            app:iconTint="@color/primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <!-- Map Container with Center Pin -->
    <FrameLayout
        android:id="@+id/fl_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/web_view_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Shadow Anchor Dot -->
        <View
            android:id="@+id/view_pin_shadow"
            android:layout_width="14dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pin_shadow"
            android:clickable="false"
            android:focusable="false" />

        <!-- Floating Center Pin (Tip is precisely at center) -->
        <ImageView
            android:id="@+id/iv_center_pin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/ic_location"
            app:tint="@color/primary" />

        <!-- Floating Helper Badge above Pin -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="60dp"
            android:background="@drawable/bg_pill_white"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Delivery Spot"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Floating GPS Re-Center FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="Locate Me"
            android:src="@drawable/ic_location"
            app:backgroundTint="@color/surface"
            app:elevation="4dp"
            app:fabSize="mini"
            app:tint="@color/primary" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/map_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Address Info & Action Card with Top Shadow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_map_card_top"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Badge & Geocoding Spinner Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="DELIVERY ADDRESS"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/pb_geocoding"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Selected Address Title -->
        <TextView
            android:id="@+id/tv_picked_address_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 Pin Location"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Selected Address Detailed Description -->
        <TextView
            android:id="@+id/tv_picked_address_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="Detecting location..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_external_map"
                style="@style/Widget.AKR.Button.PillSoft"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Google Maps"
                android:textSize="12sp"
                app:icon="@drawable/ic_map"
                app:iconTint="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_location"
                style="@style/Widget.AKR.Button.Pill"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.3"
                android:text="Confirm Location"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
