<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="2dp">

    <!-- Timeline Indicator Column: Top Line + 36dp Node + Bottom Line -->
    <LinearLayout
        android:layout_width="38dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Top Connecting Line (Invisible on first step) -->
        <View
            android:id="@+id/v_step_line_top"
            android:layout_width="2.5dp"
            android:layout_height="8dp"
            android:background="@color/divider" />

        <!-- Circular Status Node -->
        <FrameLayout
            android:id="@+id/frame_step_node"
            android:layout_width="34dp"
            android:layout_height="34dp">

            <View
                android:id="@+id/v_step_dot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_step_node_upcoming" />

            <TextView
                android:id="@+id/tv_step_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- Bottom Connecting Line -->
        <View
            android:id="@+id/v_step_line"
            android:layout_width="2.5dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:background="@color/divider" />

    </LinearLayout>

    <!-- 2050 Futuristic Step Card Content (Bubble) -->
    <LinearLayout
        android:id="@+id/card_step_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_step_card_idle"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <!-- Step Title + Status Pill Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_step_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01"
                android:text="Step Title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Dynamic Stage Badge -->
            <TextView
                android:id="@+id/tv_step_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:text="STAGE"
                android:textColor="@color/primary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Step Rich Description / Subtitle -->
        <TextView
            android:id="@+id/tv_step_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="1dp"
            android:text="Detailed step description goes here"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Optional Timestamp / Note -->
        <TextView
            android:id="@+id/tv_step_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_hint"
            android:textSize="10.5sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>