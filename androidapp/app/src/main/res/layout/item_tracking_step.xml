<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp">

    <!-- Timeline Indicator Column: Dot + Vertical Connecting Line -->
    <LinearLayout
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/v_step_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_step_dot"
            android:elevation="2dp" />

        <View
            android:id="@+id/v_step_line"
            android:layout_width="2dp"
            android:layout_height="42dp"
            android:layout_marginVertical="3dp"
            android:background="@color/divider_hairline" />

    </LinearLayout>

    <!-- Emoji Avatar Badge -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_icon_circle_soft">

        <TextView
            android:id="@+id/tv_step_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Step Label Text -->
    <TextView
        android:id="@+id/tv_step_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="-0.01"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</LinearLayout>