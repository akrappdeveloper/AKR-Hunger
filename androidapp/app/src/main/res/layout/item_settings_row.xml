<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Leading Icon Container with Soft Glow -->
    <FrameLayout
        android:id="@+id/layout_settings_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_icon_circle_soft">

        <ImageView
            android:id="@+id/iv_settings_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Setting Icon"
            android:src="@drawable/ic_settings"
            app:tint="@color/primary" />
    </FrameLayout>

    <!-- Title + Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:letterSpacing="-0.01" />

        <TextView
            android:id="@+id/tv_settings_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="1dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Value Badge / Current State Pill -->
    <TextView
        android:id="@+id/tv_settings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_pill_soft"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/primary"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <!-- Trailing Action Indicator (Chevron / Switch placeholder) -->
    <ImageView
        android:id="@+id/iv_settings_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="Next"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_hint" />

</LinearLayout>