<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_nav_ios"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- iOS Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill_soft" />

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="💰 Add Money to Wallet"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="Instant wallet credit • Zero transaction fees • No limit"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Amount Input Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="₹"
                android:textColor="@color/primary"
                android:textSize="28sp" />

            <EditText
                android:id="@+id/et_dialog_amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:fontFamily="sans-serif-bold"
                android:hint="0"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="26sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Add Pills -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.04"
        android:text="POPULAR AMOUNTS"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_100"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+₹100"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip_200"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+₹200"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip_500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+₹500"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip_1000"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_soft"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-bold"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+₹1000"
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Security Trust Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="🔒 256-bit Encrypted • 100% Safe via Razorpay"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_proceed"
        style="@style/Widget.AKR.Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:elevation="3dp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.02"
        android:text="Proceed to Add Money"
        android:textSize="15sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="27dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dialog_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />
</LinearLayout>
