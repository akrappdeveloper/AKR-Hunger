<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0000000">

    <!-- Full-screen swipeable images -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_fullscreen_images"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Close Button (top-right) -->
    <ImageView
        android:id="@+id/btn_fullscreen_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_white"
        android:clickable="true"
        android:contentDescription="Close"
        android:elevation="6dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_primary" />

    <!-- Image Counter (top-left) -->
    <TextView
        android:id="@+id/tv_fullscreen_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_pill_white"
        android:elevation="6dp"
        android:fontFamily="sans-serif-bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

    <!-- Dots Indicator (bottom-center) -->
    <LinearLayout
        android:id="@+id/ll_fullscreen_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp" />

</FrameLayout>
