<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Location Services (Delivery Address, Live GPS, Restaurant Search) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Push Notifications & Order Tracking Lifecycle -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Foreground Services (Live Order Tracking & Driver Sync) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Camera & Storage (Profile Photos, Food Reviews, Receipt Proof) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Phone Support & Driver Contact -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Voice Search for Dishes & Restaurants -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Biometric Authentication for Secure Checkout & Wallet -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Hardware Feature Requirements (all optional to support all Android devices) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".AKRHungerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AKRHunger"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Splash / Login Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AKRHunger.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity with Referral Deep Link Support -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="shunger.vercel.app"
                    android:pathPrefix="/customer/referral" />
                <data
                    android:scheme="https"
                    android:host="akrhunger.vercel.app"
                    android:pathPrefix="/customer/referral" />
            </intent-filter>
        </activity>

        <!-- Forgot Password Activity -->
        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity (Bottom Nav Host) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Restaurant Detail Activity -->
        <activity
            android:name=".activities.RestaurantDetailActivity"
            android:exported="false" />

        <!-- Product Detail Activity -->
        <activity
            android:name=".activities.ProductDetailActivity"
            android:exported="false" />

        <!-- Full-Screen Image Viewer (Product carousel tap-to-zoom lightbox) -->
        <activity
            android:name=".activities.FullScreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AKRHunger.Splash" />

        <!-- Cart / Checkout Activity -->
        <activity
            android:name=".activities.CartActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Order Detail Activity -->
        <activity
            android:name=".activities.OrderDetailActivity"
            android:exported="false" />

        <!-- Search Activity -->
        <activity
            android:name=".activities.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Wallet Activity -->
        <activity
            android:name=".activities.WalletActivity"
            android:exported="false" />

        <!-- Support Activity -->
        <activity
            android:name=".activities.SupportActivity"
            android:exported="false" />

        <!-- Edit Profile Activity -->
        <activity
            android:name=".activities.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications Activity -->
        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false" />

        <!-- Settings Activity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <!-- Addresses Activity -->
        <activity
            android:name=".activities.AddressesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Rewards / Loyalty Activity -->
        <activity
            android:name=".activities.RewardsActivity"
            android:exported="false" />

        <!-- Membership Subscription Activity -->
        <activity
            android:name=".activities.MembershipActivity"
            android:exported="false" />

        <!-- 🆕 Group Order Activity — with deep link for invite links -->
        <activity
            android:name=".activities.GroupOrderActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="akrhunger.vercel.app"
                    android:pathPrefix="/customer/group" />
            </intent-filter>
        </activity>

        <!-- 🆕 Student Mode Activity -->
        <activity
            android:name=".activities.StudentModeActivity"
            android:exported="false" />

        <!-- 🆕 Meal Subscription Activity -->
        <activity
            android:name=".activities.SubscriptionActivity"
            android:exported="false" />

        <!-- 🆕 Delivery Partner Dashboard Activity -->
        <activity
            android:name=".activities.DeliveryPartnerDashboardActivity"
            android:exported="false" />

        <!-- Live Order Tracking Activity -->
        <activity
            android:name=".activities.OrderTrackingActivity"
            android:exported="false" />

        <!-- Write Review Activity -->
        <activity
            android:name=".activities.WriteReviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Deals &amp; Offers Activity -->
        <activity
            android:name=".activities.DealsActivity"
            android:exported="false" />

        <!-- Referral Program Activity -->
        <activity
            android:name=".activities.ReferralActivity"
            android:exported="false" />

        <!-- Order Cancellation Activity -->
        <activity
            android:name=".activities.OrderCancellationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- FCM Service -->
        <service
            android:name=".services.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Driver GPS Location Service (foreground service for delivery partner tracking) -->
        <service
            android:name=".services.DriverLocationService"
            android:exported="false"
            android:foregroundServiceType="location"
            android:enabled="true" />

        <!-- Razorpay meta -->
        <meta-data
            android:name="com.razorpay.ApiKey"
            android:value="rzp_live_RbvSxxE0Qca3fp" />

        <!-- FileProvider for Camera Photo Capturing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
