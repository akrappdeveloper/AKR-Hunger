<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Location Services (Live GPS Broadcasting & Radar) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Push Notifications & Alert Vibration -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Services for Live Driver Tracking & Data Sync -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Camera & Storage (Proof of Delivery, Bag Photo, KYC Documents) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Customer & Restaurant Hotline Calling -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Device Boot & Battery Optimization for Uninterrupted Delivery Orders -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Hardware Features (Optional so all Android devices can install) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".AKRDeliveryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AKRHunger"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Splash Activity -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AKRHunger.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Activity -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Active Order Step-by-Step Activity -->
        <activity
            android:name=".activities.OrderActiveDetailActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Rider Real-time Chat Activity -->
        <activity
            android:name=".activities.RiderChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Partner Wallet & COD Management Activity -->
        <activity
            android:name=".activities.WalletActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Customer Reviews & Rating Activity -->
        <activity
            android:name=".activities.ReviewsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Partner App Settings Activity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Partner Support & Ticket System Activity -->
        <activity
            android:name=".activities.SupportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications Center Activity -->
        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Live Telemetry Radar Activity -->
        <activity
            android:name=".activities.LiveTrackingRadarActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GPS Foreground Tracking Service -->
        <service
            android:name=".services.DriverLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".services.DeliveryFCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
