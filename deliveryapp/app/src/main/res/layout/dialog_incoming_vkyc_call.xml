<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal">

    <!-- Indigo Gradient Header Banner -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#6366F1">

        <!-- Decorative circle blobs -->
        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="-40dp"
            android:layout_marginTop="-40dp"
            android:background="#1AFFFFFF" />

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="-20dp"
            android:background="#12FFFFFF" />

        <!-- Pulsing ring around camera icon -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp">

            <!-- Outer pulse ring -->
            <View
                android:id="@+id/view_pulse_ring"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_circle_soft"
                android:alpha="0.7" />

            <!-- Inner icon circle -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_primary"
                android:backgroundTint="#5AFFFFFF">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_video"
                    app:tint="@color/white"
                    android:contentDescription="Video KYC" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Calling pill -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="#1F6366F1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="INCOMING VIDEO KYC CALL"
            android:textColor="#6366F1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tv_vkyc_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="KYC Verification Officer"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- From badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hunger Delivery Operations Team"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <!-- Info text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hunger Admin is requesting a live video call to verify your identity and physical driving documents for onboarding approval."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.35"
            android:textAlignment="center" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <!-- Decline Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decline_vkyc"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Decline"
                android:textAllCaps="false"
                android:textColor="@color/error"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:strokeColor="@color/error"
                app:strokeWidth="1.5dp" />

            <!-- Connect Live Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_vkyc"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.5"
                android:backgroundTint="#6366F1"
                android:text="Connect Live"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_video"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
