<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <!-- Top Action Header: App Title, Partner Branding, SOS, Notifications -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/primary_tint_border"
                        app:cardBackgroundColor="@color/surface">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="4dp"
                            android:src="@drawable/ic_hunger_delivery_partner"
                            android:contentDescription="Hunger Delivery Partner" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hunger Delivery"
                            android:textColor="@color/text_primary"
                            android:textSize="18.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.02" />

                        <TextView
                            android:id="@+id/tv_header_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Rider Partner Portal"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- SOS Emergency Icon -->
                    <ImageButton
                        android:id="@+id/btn_header_sos"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill_primary"
                        android:backgroundTint="@color/error_light"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/error"
                        android:contentDescription="SOS Emergency" />

                    <!-- Notification Bell Icon -->
                    <ImageButton
                        android:id="@+id/btn_header_notifications"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_primary"
                        android:backgroundTint="@color/surface_variant"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/text_primary"
                        android:contentDescription="Notifications" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Location & Map Section (Shown when ONLINE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_map_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1.2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:id="@+id/layout_map_viewport"
                        android:layout_width="match_parent"
                        android:layout_height="480dp">

                        <org.osmdroid.views.MapView
                            android:id="@+id/map_fragment"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Map Top Left: GPS Active Indicator Pill -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_map_gps_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentStart="true"
                            android:layout_marginTop="12dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#33FFFFFF"
                            app:cardBackgroundColor="@color/dark_card_bg">

                            <TextView
                                android:id="@+id/tv_map_gps_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="7dp"
                                android:text="🛰️ GPS Live"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Map Top Right: Online Status & Offline Switch Button -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_map_offline_control"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="12dp"
                            android:layout_marginEnd="12dp"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="6dp"
                            app:strokeWidth="1.2dp"
                            app:strokeColor="@color/neon_green"
                            app:cardBackgroundColor="@color/dark_card_bg">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="6dp"
                                android:paddingVertical="4dp">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_pill_primary"
                                    android:backgroundTint="@color/neon_green" />

                                <TextView
                                    android:id="@+id/tv_map_status_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginEnd="4dp"
                                    android:text="ONLINE"
                                    android:textColor="@color/neon_green"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.02" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/switch_map_offline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    app:thumbTint="@color/neon_green"
                                    app:trackTint="#40CCFF00" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Google Maps Style Right Controls: Compass, Zoom In, Zoom Out, Re-center
                        Location -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginEnd="14dp"
                            android:layout_marginBottom="14dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <!-- Compass / North Reset Button -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_map_compass"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginBottom="8dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="5dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/card_border"
                                app:cardBackgroundColor="@color/surface">

                                <ImageView
                                    android:id="@+id/iv_map_compass"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_location"
                                    app:tint="@color/error"
                                    android:contentDescription="Reset North" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Fit Complete Route Button -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_map_fit_route"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginBottom="8dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="5dp"
                                app:strokeWidth="1.2dp"
                                app:strokeColor="@color/neon_green"
                                app:cardBackgroundColor="@color/dark_card_bg">

                                <ImageView
                                    android:id="@+id/iv_map_fit_route"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_map"
                                    app:tint="@color/neon_green"
                                    android:contentDescription="Fit Complete Route" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Zoom In Button -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_map_zoom_in"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="5dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/card_border"
                                app:cardBackgroundColor="@color/surface">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_add"
                                    app:tint="@color/text_primary"
                                    android:contentDescription="Zoom In" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Zoom Out Button -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_map_zoom_out"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="5dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="@color/card_border"
                                app:cardBackgroundColor="@color/surface">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="9dp"
                                    android:src="@drawable/ic_minus"
                                    app:tint="@color/text_primary"
                                    android:contentDescription="Zoom Out" />
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Re-center Location FAB -->
                            <com.google.android.material.floatingactionbutton.FloatingActionButton
                                android:id="@+id/btn_current_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:src="@drawable/ic_location"
                                app:backgroundTint="@color/surface"
                                app:tint="@color/primary"
                                app:fabSize="mini"
                                app:elevation="6dp"
                                android:contentDescription="Re-center on current position" />
                        </LinearLayout>
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:background="@color/surface">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/primary" />

                        <TextView
                            android:id="@+id/tv_current_location"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:text="Locating your position..."
                            android:textColor="@color/text_primary"
                            android:textSize="13.5sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/btn_map_pincodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_primary"
                            android:backgroundTint="@color/surface_variant"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="📍 Areas"
                            android:textColor="@color/primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <!-- Quick Call Action for Active Order -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_map_call_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#5010B981"
                            app:cardBackgroundColor="#2510B981"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_phone"
                                    app:tint="@color/veg_green" />

                                <TextView
                                    android:id="@+id/tv_map_call_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="Call"
                                    android:textColor="@color/veg_green"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Online / Offline Hero Card (Dark Theme + Neon Green) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_status_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/dark_card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true">

                            <View
                                android:id="@+id/view_status_indicator"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_pill_primary"
                                android:backgroundTint="@color/error" />

                            <TextView
                                android:id="@+id/tv_status_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="OFFLINE"
                                android:textColor="@color/white"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_online"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tv_status_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Turn toggle ON to start receiving delivery requests near you."
                        android:textColor="#A0A0A0"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.2" />

                    <!-- Quick Action Chips Row (GPS status & Pincodes) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tv_gps_status"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_pill_primary"
                            android:backgroundTint="#33FFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:text="🛰️ GPS Standby"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAlignment="center" />

                        <TextView
                            android:id="@+id/btn_manage_pincodes"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_primary"
                            android:backgroundTint="#33FFFFFF"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp"
                            android:text="📍 Service Areas"
                            android:textColor="@color/neon_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAlignment="center" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KYC Verification Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_kyc_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/warning"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/warning_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Action Required: Complete V-KYC"
                        android:textColor="@color/warning"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="You must complete Video KYC to activate your account and start receiving orders."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_book_vkyc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Book V-KYC Slot"
                        app:backgroundTint="@color/warning"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Deliveries Section -->
            <LinearLayout
                android:id="@+id/layout_active_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="22dp"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Deliveries"
                        android:textColor="@color/text_primary"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_active_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_pill_primary"
                        android:backgroundTint="@color/primary"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="4dp"
                        android:text="1 active"
                        android:textColor="@color/on_primary"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_active_orders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Available Orders Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Orders"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_available_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_primary"
                    android:backgroundTint="@color/surface_variant"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="4dp"
                    android:text="0 waiting"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Empty State for Available Orders -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_empty_available"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="40dp"
                    android:paddingHorizontal="24dp">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:src="@drawable/ic_bike_professional"
                        app:tint="@color/text_hint" />

                    <TextView
                        android:id="@+id/tv_empty_available_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="You are offline. Turn switch ON to start receiving order broadcasts."
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Orders List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_available_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>