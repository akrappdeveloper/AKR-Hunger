<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Header with Icon Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="@color/primary_tint"
            android:padding="11dp"
            android:src="@drawable/ic_wallet"
            app:tint="@color/primary"
            android:contentDescription="Deposit COD" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deposit COD to Platform"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Settle cash collected to keep your COD limit active"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/divider" />

    <!-- Summary Box -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/warning"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/warning_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Current COD In Hand:"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deposit_cod_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="@color/warning"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Amount Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chip_full"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Full Due"
            android:textColor="@color/primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="19dp"
            app:backgroundTint="@color/primary_tint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chip_500"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="₹500"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="19dp"
            app:backgroundTint="@color/surface_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_chip_1000"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="₹1,000"
            android:textColor="@color/text_primary"
            android:textSize="11.5sp"
            android:textStyle="bold"
            app:cornerRadius="19dp"
            app:backgroundTint="@color/surface_variant" />
    </LinearLayout>

    <!-- Amount Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/primary"
        app:prefixText="₹ "
        app:prefixTextColor="@color/text_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_deposit_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount to deposit"
            android:inputType="numberDecimal"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Payment Gateway Mode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Payment Method"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <RadioGroup
        android:id="@+id/rg_deposit_method"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rb_deposit_upi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPI App (GPay / PhonePe / Paytm)"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:checked="true" />

        <RadioButton
            android:id="@+id/rb_deposit_gateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Net Banking / Debit Card"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />
    </RadioGroup>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_deposit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:strokeColor="@color/card_border"
            app:cornerRadius="25dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_deposit"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1.4"
            android:text="Pay &amp; Settle COD"
            android:textColor="@color/on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="25dp"
            app:elevation="2dp" />
    </LinearLayout>
</LinearLayout>
