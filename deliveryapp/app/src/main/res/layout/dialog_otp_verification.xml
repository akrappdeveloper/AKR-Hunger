<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Shield Icon -->
    <ImageView
        android:id="@+id/iv_otp_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_pill_primary"
        android:backgroundTint="@color/primary_tint"
        android:padding="16dp"
        android:src="@drawable/ic_shield_check"
        app:tint="@color/primary"
        android:contentDescription="OTP Verification" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_otp_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Verify Delivery OTP"
        android:textAlignment="center"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_otp_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ask customer for the delivery OTP to securely complete this delivery."
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.3" />

    <!-- OTP Input Box -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxCornerRadiusTopStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusBottomEnd="18dp"
        app:boxStrokeColor="@color/primary"
        app:boxStrokeWidthFocused="2dp"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_otp_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="• • • •"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:textAlignment="center"
            android:letterSpacing="0.4"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingVertical="14dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Helper text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter the OTP shared by the customer"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textAlignment="center" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_otp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:strokeColor="@color/card_border"
            app:cornerRadius="26dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_otp"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:text="✓ Verify &amp; Complete"
            android:textColor="@color/on_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="26dp"
            app:elevation="2dp" />
    </LinearLayout>
</LinearLayout>
