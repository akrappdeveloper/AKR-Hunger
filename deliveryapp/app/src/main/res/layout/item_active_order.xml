<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/dark_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Stage Badge (Neon Green) -->
        <TextView
            android:id="@+id/tv_active_stage_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_primary"
            android:backgroundTint="@color/neon_green"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="IN TRANSIT"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Origin -> Destination -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tv_active_restaurant_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Norra Nynäshamn"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="8dp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_active_delivery_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stockholm"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Order ID -->
        <TextView
            android:id="@+id/tv_active_order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Order ID #29698-98971"
            android:textColor="#A0A0A0"
            android:textSize="13sp" />

        <!-- Neon Green Progress Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="60dp"
            android:background="@color/neon_green" />
        
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="-3dp"
            android:layout_marginStart="280dp"
            android:background="#404040" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Earning"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_active_earnings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹65"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment"
                    android:textColor="#A0A0A0"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tv_active_payment_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online Paid"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Actions: Google Maps, In-App Route, Call & Manage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <!-- Row 1: Google Maps & In-App Route -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_google_maps"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="🗺️ Google Maps"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2563EB"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_navigate_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="📍 View on Map"
                    app:icon="@drawable/ic_map"
                    app:iconTint="@color/neon_green"
                    app:iconSize="16dp"
                    app:strokeColor="@color/neon_green"
                    app:strokeWidth="1.2dp"
                    android:textColor="@color/neon_green"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="22dp" />
            </LinearLayout>

            <!-- Row 2: Call Contact & Manage Order -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call_order"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="📞 Call Contact"
                    app:icon="@drawable/ic_phone"
                    app:iconTint="@color/white"
                    app:iconSize="16dp"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="22dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_order"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="⚡ Manage Order"
                    android:textColor="@color/black"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/neon_green"
                    app:cornerRadius="22dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
