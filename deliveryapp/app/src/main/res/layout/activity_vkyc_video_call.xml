<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Admin/Remote Video View -->
    <ImageView
        android:id="@+id/remote_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_video"
        app:tint="@color/text_secondary"
        android:background="@color/black" />

    <!-- Gradient Overlay at Top for Header Visibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentTop="true"
        android:background="#80000000" />

    <!-- Admin Badge & Live Status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="48dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_dark_glass"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_online_dot" />

        <TextView
            android:id="@+id/tv_admin_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Hunger Admin (Connecting...)"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Gradient Overlay at Bottom for Controls Visibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_alignParentBottom="true"
        android:background="#99000000" />

    <!-- Self/Local Video View PiP -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="112dp"
        android:layout_height="160dp"
        android:layout_above="@+id/layout_controls"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="12dp"
        app:strokeColor="#66FFFFFF"
        app:strokeWidth="1.5dp">

        <ImageView
            android:id="@+id/local_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2E2E2E"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_user"
            app:tint="@color/text_hint" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="#80000000"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp" />
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Call Controls Floating Glass Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="36dp"
        app:cardCornerRadius="40dp"
        app:cardBackgroundColor="#66000000"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="1dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp">

            <!-- Mic Mute Button -->
            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_pill_primary"
                android:backgroundTint="#40FFFFFF"
                android:src="@drawable/ic_mic"
                app:tint="@color/white"
                android:contentDescription="Mute" />

            <!-- End Call Button -->
            <ImageButton
                android:id="@+id/btn_end_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_pill_primary"
                android:backgroundTint="@color/error"
                android:src="@drawable/ic_phone"
                app:tint="@color/white"
                android:contentDescription="End Call" />

            <!-- Video Toggle Button -->
            <ImageButton
                android:id="@+id/btn_video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_pill_primary"
                android:backgroundTint="#40FFFFFF"
                android:src="@drawable/ic_video"
                app:tint="@color/white"
                android:contentDescription="Toggle Video" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
