<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 Rider Safety SOS"
        android:textColor="@color/error"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Select an emergency service for immediate assistance on the road."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Police 112 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos_police"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Call Police (112)"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_phone"
        app:backgroundTint="@color/error"
        app:cornerRadius="25dp" />

    <!-- Ambulance 108 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos_ambulance"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Call Ambulance (108)"
        android:textColor="@color/on_primary"
        app:icon="@drawable/ic_phone"
        app:backgroundTint="@color/secondary"
        app:cornerRadius="25dp" />

    <!-- Partner Helpline -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos_helpline"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:text="Hunger 24x7 Safety Desk"
        android:textColor="@color/primary"
        app:icon="@drawable/ic_headset"
        app:strokeColor="@color/primary"
        app:cornerRadius="25dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_sos"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="Dismiss"
        android:textColor="@color/text_secondary" />
</LinearLayout>
