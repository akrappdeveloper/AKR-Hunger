<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Standardized 44dp Transaction Direction Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_soft"
            android:padding="11dp">

            <ImageView
                android:id="@+id/iv_tx_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_arrow_down_left"
                app:tint="@color/veg_green"
                android:contentDescription="Transaction Icon" />
        </FrameLayout>

        <!-- Transaction Description & Timeline -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tx_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Earning"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_tx_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Order #1024 • Delivered"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_hint"
                    android:contentDescription="Timestamp" />

                <TextView
                    android:id="@+id/tv_tx_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="10 Oct, 08:30 PM"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transaction Amount & Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tx_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹65.00"
                android:textColor="@color/veg_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tv_tx_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_emerald_soft"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:text="COMPLETED"
                android:textColor="@color/veg_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
